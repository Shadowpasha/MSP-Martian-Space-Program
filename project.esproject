{
  "formatVersion": "1",
  "name": "Mars Station Program",
  "description": "NASA Space Apps 2026: Main Martian outpost survival loop with crew perks, Gemini AI task planner, 60-Seconds-style daily events, and skill tree integration.",
  "tag": "Game",
  "version": "0.1.0",
  "defaultScene": "assets/scenes/main.esscene",
  "designResolution": {
    "width": 1280,
    "height": 720
  },
  "features": {
    "rendering": {
      "cameraScaleMode": "expand"
    },
    "audio": {
      "buses": [
        {
          "name": "music",
          "volume": 0.18
        },
        {
          "name": "sfx",
          "volume": 0.34
        },
        {
          "name": "master",
          "volume": 0.53
        },
        {
          "name": "ui",
          "volume": 0.54
        },
        {
          "name": "voice",
          "volume": 0.56
        }
      ]
    }
  },
  "spineVersion": "none",
  "packaging": {
    "platform": "web",
    "config": "shipping",
    "sourceMaps": false,
    "assetCompression": "auto",
    "frameDebugger": false,
    "openFolder": true,
    "outDir": {
      "web": "dist-web"
    }
  }
}
