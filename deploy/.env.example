# Settings for the game server. Copy this file to .env next to docker-compose.yml and fill it in.
# Never commit the real .env: it holds your API key.

# Public address of the game, as players open it (several: separate with commas).
# A.R.I.E.S. only answers pages opened from these addresses (or from localhost).
MSP_PUBLIC_URL=https://msp.example.com

# Gemini API key. Turns on A.R.I.E.S. (live briefings and the work-order assistant).
# Leave empty to run with the built-in briefings only.
GEMINI_API_KEY=

# Optional: Gemini model (default gemini-3-flash-preview).
GEMINI_MODEL=

# Limits that protect your Gemini quota.
# Requests per visitor per minute, and for the whole server per day (0 turns A.R.I.E.S. off).
MSP_AI_PER_MINUTE=6
MSP_AI_PER_DAY=300

# Port on this server (127.0.0.1 only) that your tunnel or reverse proxy connects to.
MSP_HOST_PORT=8070

# Optional: a different image or a pinned release, e.g. ghcr.io/shadowpasha/msp-martian-space-program:v1.0.0
# MSP_IMAGE=ghcr.io/shadowpasha/msp-martian-space-program:latest
